{
  "schemaVersion": 1,
  "id": "aquaclient",
  "version": "${version}",
  "name": "Aqua Client",
  "description": "Aqua Client: a clean PvP/utility HUD with an animated menu, armor HUD, keystrokes, CPS and more. Bundles Sodium, Lithium and ImmediatelyFast.",
  "authors": ["You"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.aqua.AquaClient"]
  },
  "mixins": [
    { "config": "aquaclient.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
